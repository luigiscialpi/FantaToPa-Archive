# Client pubblico (va bene nel bundle browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO server-side: script di ingestion, mai nel client/browser (AGENTS.md)
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function invio email (sezione 9 del piano) — non ancora attivato
RESEND_API_KEY=

# Notifica admin su nuova registrazione in attesa (bot via @BotFather + chat_id da getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Best-effort: a fine import svuota la cache delle query home su apps/web
# (packages/ingestion/lib/revalidate-web-cache.ts). WEB_REVALIDATE_URL è
# l'URL pubblico del sito (un solo ambiente Supabase+Netlify, nessuno
# staging separato: un import da qui aggiorna subito ciò che vedono gli
# utenti reali). WEB_REVALIDATE_SECRET deve combaciare con REVALIDATE_SECRET
# configurato su Netlify (env var del sito, non in un file). Se assenti,
# l'import non fallisce: la cache si aggiorna comunque da sola entro
# HOME_STATS_REVALIDATE_SECONDS.
WEB_REVALIDATE_URL=
WEB_REVALIDATE_SECRET=
