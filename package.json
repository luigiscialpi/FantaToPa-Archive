{
  "name": "fantatopa-archive",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "dev": "npm run dev --workspace=apps/web"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "exceljs": "^4.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  }
}
